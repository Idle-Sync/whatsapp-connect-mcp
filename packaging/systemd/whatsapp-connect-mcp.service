# User service for the shared whatsapp-connect-mcp HTTP server.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp whatsapp-connect-mcp.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now whatsapp-connect-mcp
#   loginctl enable-linger "$USER"   # keep it running while logged out
#
# Notes:
# - An unpaired install does not crash-loop: serve waits idle, re-checking
#   every 15s, so `whatsapp-connect-mcp setup` can pair while the service
#   is running.
# - The single-instance lock means a second copy exits immediately with a
#   clear error rather than corrupting the data directory.
# - Adjust ExecStart if the binary is installed somewhere other than
#   ~/.local/bin (the install.sh default).

[Unit]
Description=WhatsApp Connect MCP server (shared HTTP)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/whatsapp-connect-mcp serve --http 127.0.0.1:2178
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
